            <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
            <script>
                (function () {
                    var source = document.getElementById('blog-md-source');
                    var target = document.getElementById('blog-md-rendered');
                    var titleEl = document.querySelector('.blog-post-title');
                    var authorEl = document.querySelector('.blog-post-author');
                    if (!source || !target || !window.marked) return;

                    // Escape a string for safe use inside a RegExp
                    function escapeRegExp(str) {
                        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    }

                    var cleaned = (source.textContent || '')
                        .replace(/\r\n/g, '\n')
                        .trim();

                    // Strip a leading markdown title line (e.g. "# **Title**") if it
                    // matches the page's own <h2 class="blog-post-title"> text, so we
                    // never hardcode a specific post's title here.
                    if (titleEl) {
                        var titleText = titleEl.textContent.trim();
                        var titlePattern = new RegExp('^#+\\s*\\**\\s*' + escapeRegExp(titleText) + '\\s*\\**\\s*\\n?', 'i');
                        cleaned = cleaned.replace(titlePattern, '');
                    }

                    // Strip a leading byline line (e.g. "*Author One, Author Two*") if
                    // it matches the page's own .blog-post-author text.
                    if (authorEl) {
                        var authorText = authorEl.textContent.trim();
                        // Byline may use "and"/"," interchangeably between the h2 meta
                        // and the markdown source, so split on both and match loosely.
                        var authorNames = authorText.split(/,|\band\b/i).map(function (s) {
                            return s.trim();
                        }).filter(Boolean);
                        var authorAlternation = authorNames.map(escapeRegExp).join('|');
                        if (authorAlternation) {
                            var authorPattern = new RegExp('^\\s*\\*[^\\n]*(' + authorAlternation + ')[^\\n]*\\*\\s*\\n?', 'i');
                            cleaned = cleaned.replace(authorPattern, '');
                        }
                    }

                    cleaned = cleaned
                        .replace(/^\s*·\s*/gm, '- ')
                        .replace(/\n{3,}/g, '\n\n')
                        .trim();

                    target.innerHTML = window.marked.parse(cleaned);

                    // Belt-and-suspenders: if a duplicate heading/byline still slipped
                    // through (e.g. wording didn't match exactly), remove it.
                    var firstHeading = target.querySelector('h1, h2');
                    if (titleEl && firstHeading && firstHeading.textContent.trim().toLowerCase() === titleEl.textContent.trim().toLowerCase()) {
                        firstHeading.remove();
                    }
                    var firstPara = target.querySelector('p');
                    if (authorEl && firstPara) {
                        var firstParaLower = firstPara.textContent.toLowerCase();
                        var authorHit = authorEl.textContent.split(/,|\band\b/i).some(function (name) {
                            name = name.trim().toLowerCase();
                            return name && firstParaLower.indexOf(name) !== -1;
                        });
                        if (authorHit) firstPara.remove();
                    }

                    var citationHeadings = target.querySelectorAll('h1, h2, h3, h4');
                    citationHeadings.forEach(function (heading) {
                        if (!/references|bibliography|cited works|additional sources/i.test(heading.textContent || '')) return;
                        var next = heading.nextElementSibling;
                        while (next && !/^(OL|UL)$/i.test(next.tagName)) {
                            next = next.nextElementSibling;
                        }
                        if (next) next.classList.add('blog-ref-list');
                    });
                    target.querySelectorAll('a').forEach(function (a) {
                        a.classList.add('text-link');
                        if (!a.getAttribute('target')) a.setAttribute('target', '_blank');
                        if (!a.getAttribute('rel')) a.setAttribute('rel', 'noopener noreferrer');
                    });
                })();
            </script>

